# Copy to .env at the repo root and adjust.

# PostgreSQL (docker-compose default; adjust user/password/host as needed)
DATABASE_URL=postgresql+asyncpg://energy:energy@localhost:5432/energlens

# Auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_LIFETIME_SECONDS=604800

# Where the SPA lives (OAuth logins redirect back here)
FRONTEND_URL=http://localhost:5173

# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:5173

# OAuth apps (optional — the providers' login routes are only mounted when set)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Set false only for plain-http localhost testing in Safari
OAUTH_COOKIE_SECURE=true

# GitHub MCP server — used by the agent harness configs (.mcp.json,
# .cursor/mcp.json, .gemini/settings.json, .codex/config.toml). Never committed.
# Fine-grained PAT: https://github.com/settings/personal-access-tokens
# Leave blank to fall back to your gh CLI login (`gh auth login`).
GITHUB_MCP_PAT=
