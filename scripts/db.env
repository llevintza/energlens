# Canonical database identity for local development and CI. Single source of truth.
#
# These are libpq's own variable names, so anything that sources this file can
# run bare `psql`, `createdb` and `pg_isready` with no flags.
#
# Sourced by scripts/db.sh and scripts/pgdev.sh, parsed by
# backend/tests/conftest.py, and passed to docker compose via --env-file.
#
# Two consumers cannot read this file at the moment they need it, and so keep
# their own literal copies:
#
#   backend/app/config.py      deployed without scripts/ (render.yaml rootDir),
#                              and must do no file I/O at import time
#   .github/workflows/*.yml    the postgres service block is evaluated before
#                              the repository is checked out
#
# Those copies are pinned by backend/tests/test_config.py, so drift fails a
# required check rather than surfacing as a confusing connection error.

PGUSER=energy
PGPASSWORD=energy
PGHOST=localhost
PGPORT=5432

# The application database. Bills live here; `make db-reset` will drop it.
PGDATABASE=energlens

# The test database. backend/tests/conftest.py drops every table in it on each
# run, so it must never be the same name as PGDATABASE.
PGDATABASE_TEST=energlens_test
