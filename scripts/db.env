# Canonical database identity for local development and CI. Single source of truth.
#
# A sourceable shell fragment, not a dotenv file: `:=` means anything already in
# the environment wins, so `PGPORT=5433 make db-up` works, and both scripts/db.sh
# and scripts/pgdev.sh pick it up with a single `.` line rather than each
# reimplementing a parser.
#
# These are libpq's own variable names, and they are exported, so anything that
# sources this file can run bare `psql`, `createdb` and `pg_isready` with no
# connection flags.
#
# Consumers that cannot source it, and so keep literal copies:
#
#   backend/app/config.py     ships without scripts/ (render.yaml rootDir),
#                             and must do no file I/O at import time
#   .github/workflows/*.yml   the postgres service block is evaluated before
#                             the repository is checked out
#   docker-compose.yml        needs POSTGRES_DB, which is Postgres' own name
#                             for this; scripts/db.sh passes it through
#   .env.example              copied by a human, so it must be self-contained
#
# Every one of those copies is pinned by backend/tests/test_config.py, so drift
# fails a required check instead of surfacing later as a confusing connection
# error. backend/tests/conftest.py reads this file directly.

# Local development credential for a trust-auth cluster that listens on
# localhost only — deliberately committed, and deliberately not a secret.
# scripts/db.sh refuses to run destructive work against a non-localhost host.
: "${PGUSER:=energy}"
: "${PGPASSWORD:=energy}"
: "${PGHOST:=localhost}"
: "${PGPORT:=5432}"

# The application database. Bills live here; `make db-reset` will drop it.
: "${PGDATABASE:=energlens}"

# The test database. backend/tests/conftest.py drops every table in it on each
# run, so it must never be the same name as PGDATABASE.
: "${PGDATABASE_TEST:=energlens_test}"

# Throwaway database for `make migrate-check`, dropped and rebuilt by Alembic
# alone on every run. It cannot be the test database: conftest.py builds that
# schema with Base.metadata.create_all, so `alembic check` against it always
# matches the models it was created from and the drift is invisible.
: "${PGDATABASE_MIGRATIONS:=energlens_migrations}"

export PGUSER PGPASSWORD PGHOST PGPORT
export PGDATABASE PGDATABASE_TEST PGDATABASE_MIGRATIONS
