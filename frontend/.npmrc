# `engines` in package.json is advisory on its own: npm prints EBADENGINE and
# installs anyway. This makes `npm ci` (and `make setup`) fail instead, so a
# Node version CI cannot reproduce is caught at install time rather than as a
# strange vitest failure much later.
#
# It applies to the whole tree, not just this package — jsdom, undici and
# whatwg-url all declare tighter floors than `>=22`, and this is what enforces
# them. Nothing else belongs in this file: .npmrc is where registry tokens
# usually live, and this one is committed.
engine-strict=true
