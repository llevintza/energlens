# Committed — contains NO secrets. Run `direnv allow` once after cloning.
#
# This bridges your own .env (gitignored) into the shell environment, so every
# agent harness launched from this directory — Claude Code, Cursor, Codex,
# Gemini CLI, Copilot CLI, Muse Code — inherits the same variables. The harness
# configs themselves are committed and reference the variable names only.

dotenv_if_exists .env

# Fall back to your gh CLI keyring when no PAT was supplied in .env.
: "${GITHUB_MCP_PAT:=$(gh auth token 2>/dev/null)}"
export GITHUB_MCP_PAT

if [ -z "$GITHUB_MCP_PAT" ]; then
  log_error "GITHUB_MCP_PAT is unset — the github MCP server will fail to authenticate."
  log_error "Fix: run 'gh auth login', or set GITHUB_MCP_PAT in .env (see .env.example)."
fi
