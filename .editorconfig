# Editor defaults, so a diff carries the change and not the whitespace around
# it. The churn is worse in a multi-harness repo, where each model formats
# differently and every review pays for it.
#
# Nothing in `make check` enforces this — it is a default, not a gate. And it
# deliberately sets no max_line_length: existing Python runs to 111 columns,
# and that limit belongs to ruff, which #81 adds.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.{py,toml}]
indent_size = 4

[Makefile]
# Make requires a literal tab before every recipe line.
indent_style = tab

[*.md]
# Two trailing spaces is a hard line break in Markdown.
trim_trailing_whitespace = false
